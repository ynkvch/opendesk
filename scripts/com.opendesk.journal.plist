<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Wakes every 15 minutes; journal_job exits at once unless a Flex pull or TWS sync is due. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.opendesk.journal</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-B</string>
    <string>-m</string>
    <string>server.journal_job</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__OPENDESK__</string>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__OPENDESK__/data/journal.log</string>
  <key>StandardErrorPath</key>
  <string>__OPENDESK__/data/journal.log</string>
</dict>
</plist>
